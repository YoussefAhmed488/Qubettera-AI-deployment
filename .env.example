# Template for .env. Copy to .env and fill in real values; never commit .env.
# Keys are grouped the way they appear in .env. Anything after "# optional" is
# not needed with the current configuration and is documented at the end.

# --- Answer generation ------------------------------------------------------
# openrouter | ollama | groq | wandb | kaggle
LLM_PROVIDER=wandb
QUERY_EXPANSION_PROVIDER=ollama
QUERY_EXPANSION_MODEL=qwen3:4b
QUERY_EXPANSION_BASE_URL=http://localhost:11434
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Reasoning models (e.g. Qwen3.x) think before answering. Hidden reasoning
# counts toward the generation budget, so raise MODEL_ANSWER_TOKENS when a
# thinking model needs more room.
MODEL_ENABLE_THINKING=true
LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096

# --- Weights & Biases Inference (LLM_PROVIDER=wandb) ------------------------
# Use the base URL, not /chat/completions.
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
WANDB_API_KEY=

# --- Local PostgreSQL (only used when QUBETTERA_DB=local) -------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=ragdb
PGUSER=postgres
PGPASSWORD=change_me

# --- Modal Authentication ---------------------------------------------------
# Modal_API_KEY is the spelling the deployed services expect; MODAL_API_KEY is
# accepted as an alias. Use a placeholder here and set the real secret locally
# rather than committing the value.
Modal_API_KEY=your_secret_api_key_here
# HF_TOKEN is only needed to download local weights when running in local mode.
HF_TOKEN=

# --- Supabase target (active) ----------------------------------------------
# The RAG corpus is served from Supabase; the PGHOST/PGPORT/PGDATABASE block
# above is only used when QUBETTERA_DB is set back to "local".
# Use the Session pooler URI, not the direct db.<ref>.supabase.co host: the
# direct host is IPv6-only and fails on networks without IPv6. The password is
# in the Supabase dashboard under Project Settings > Database.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
QUBETTERA_DB=supabase
# Durable LangGraph agent threads also move to Supabase on this target.
# memory | postgres
CHECKPOINT_BACKEND=postgres

# --- RAG corpus / embeddings ------------------------------------------------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIM=1024
# Document-sized embedding batches are slow remotely; 8 is the safe ceiling.
EMBEDDING_BATCH_SIZE=8
# auto selects CUDA when available; use cpu or cuda to force a device.
EMBEDDING_DEVICE=auto
# Re-embedding is a full corpus rebuild and is never required for a provider
# switch. Leave these at the values the stored corpus was built with.
PREPROCESSING_VERSION=clean-v2-chunk-v3-context
PIPELINE_VERSION=rag-pipeline-2026.09.01-context-v1

# --- Modal-hosted NLP models (active) ---------------------------------------
# Embeddings (Qwen/Qwen3-Embedding-0.6B) and sentiment
# (aieng-lab/ModernBERT-large_sentiment) are served from Modal by default, so
# no local weights are needed. Both endpoints authenticate with X-API-Key using
# Modal_API_KEY above.
# Override only if you deploy your own Modal apps.
# MODAL_EMBEDDING_URL=https://<workspace>--dual-nlp-services-qwenembedder-embed.modal.run
# MODAL_SENTIMENT_URL=https://<workspace>--dual-nlp-services-sentimentanalyzer-classify.modal.run
MODAL_TIMEOUT_SECONDS=600
# Both default to "cloud"; set them to "local" to run the models in-process
# instead (requires the optional analytics extras, and the weights cached under
# ~/.cache/huggingface).
EMBEDDING_PROVIDER=cloud
SENTIMENT_PROVIDER=cloud

# --- Retrieval and discussion tuning ---------------------------------------
ADAPTIVE_EXPANSION_MIN_SIMILARITY=0.55
DISCUSSION_ADAPTIVE_EXPANSION=false
DISCUSSION_MAX_WORKERS=5
# Optional one-time LLM review of papers the keyword cleaner would drop.
# Verdicts are cached in data/paper_relevance_cache.json by content hash.
PAPER_FILTER_LLM_ENABLED=false
PAPER_FILTER_LLM_PROVIDER=ollama
PAPER_FILTER_LLM_MODEL=qwen3:4b
PAPER_FILTER_LLM_BASE_URL=http://localhost:11434
RECENT_EXCHANGES_TO_KEEP=5
MAX_TOOL_ROUNDS=1
# Complete model context; also limited by OLLAMA_NUM_CTX / KAGGLE_LLM_NUM_CTX.
MODEL_CONTEXT_TOKENS=8192
MODEL_ANSWER_TOKENS=2048
# duckduckgo | tavily
SEARCH_PROVIDER=duckduckgo

# --- IVFFlat tuning (index build / search accuracy) ------------------------
IVFFLAT_MAX_LISTS=100
IVFFLAT_PROBES=100

# --- Image publishing (optional: docker-compose.yml does not consume these) --
DOCKERHUB_NAMESPACE=your-dockerhub-namespace
IMAGE_TAG=0.1.0

# --- Optional: not needed in the current configuration ---------------------
# OpenRouter (LLM_PROVIDER=openrouter).
# OPENROUTER_API_KEY=
# OPENROUTER_MAX_TOKENS=2048
# Groq (LLM_PROVIDER=groq).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Kaggle notebook exposing an Ollama-compatible endpoint (LLM_PROVIDER=kaggle).
# KAGGLE_LLM_URL=https://your-tunnel.example
# KAGGLE_LLM_MODEL=your-generation-model
# KAGGLE_LLM_NUM_CTX=8192
# Per-provider request timeout; LLM_TIMEOUT_SECONDS is used when set.
# LLM_TIMEOUT_SECONDS=180
# Tavily search (SEARCH_PROVIDER=tavily).
# TAVILY_API_KEY=
# Langfuse tracing.
# LANGFUSE_ENABLED=false
# Verbose agent callback logging.
# LLM_VERBOSE=false
